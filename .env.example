# Application
NODE_ENV=development
PORT=3000

# Neon PostgreSQL
# DATABASE_URL: POOLED connection string, used by PrismaClient at runtime.
# DIRECT_URL: UNPOOLED connection string, read by prisma.config.ts for the CLI and migrations.
# Prisma 7 removed the datasource `directUrl` property, so the split lives in prisma.config.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Test database. Must be a different database from the one above: the suite truncates every
# table before each test. The setup file refuses to run if these match.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/billing_test?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL_TEST="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/billing_test?sslmode=require"

# Stripe (test mode only)
# STRIPE_WEBHOOK_SECRET accepts a comma-separated list. The secret printed by
# `stripe listen --forward-to ...` differs from the Dashboard's, and rotation must not
# require a redeploy, so the verifier accepts several.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Auth module (local development stand-in for an upstream Authentication Service)
# HS256 with a symmetric secret; ticket 009 rejected asymmetric keys, since the eventual upstream
# issuer brings its own key distribution and the verifier change is small.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
BCRYPT_SALT_ROUNDS=12

# The first ADMIN. `npm run db:seed` creates this user if no user with that email exists.
# There is no runtime route that grants ADMIN — role changes are a database operation.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Service-to-service authentication for internal endpoints (cron-triggered allocation)
INTERNAL_API_KEY=

# Webhook queue worker
WEBHOOK_POLL_INTERVAL_MS=2000
WEBHOOK_BATCH_SIZE=10
WEBHOOK_MAX_RETRY_COUNT=5
WEBHOOK_RETRY_BACKOFF_MS=60000

# Credit allocation cron for annual subscriptions
CREDIT_ALLOCATION_CRON=0 3 * * *
