# Copy to .env and fill in. `.env` is gitignored.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Matches the credentials in docker-compose.yml.
DATABASE_URL="postgresql://billing:billing@localhost:5432/billing?schema=public"
# Used only by the integration test harness, which resets the schema between tests.
TEST_DATABASE_URL="postgresql://billing:billing@localhost:5432/billing_test?schema=public"

# --- Authentication ---
# Signing secret for issued JWTs. Required in production; outside production an
# unset value falls back to a fixed development secret so a fresh checkout runs.
JWT_SECRET=replace_me_with_a_long_random_string
# Access token lifetime. Short by design — this phase issues no refresh tokens,
# so a user logs in again rather than renewing.
JWT_EXPIRES_IN=15m

# --- Stripe ---
# Test-mode secret key from the Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_replace_me
# Signing secret for the webhook endpoint. When forwarding locally with
# `stripe listen --forward-to localhost:3000/webhooks/stripe`, use the whsec_...
# value that command prints; in deployed environments use the endpoint's secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Stripe Price identifiers, consumed by `npx prisma db seed` ---
# A fresh Stripe test account produces different ids, so the catalog takes them
# from here rather than hard-coding them. Create the prices exactly as described
# in docs/stripe-setup.md, then paste their ids below.
STRIPE_PRICE_AI_FREE_MONTHLY=price_replace_me
STRIPE_PRICE_AI_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_AI_PRO_ANNUAL=price_replace_me
STRIPE_PRICE_AI_ADDON_100=price_replace_me
STRIPE_PRICE_AI_ADDON_500=price_replace_me
